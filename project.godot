; Engine configuration file.

config_version=5

[application]

config/name="Factory Tycoon 3D"
config/description="Quản Lý Nhà Máy – 3D Idle Tycoon (Prototype 0.3)"
config/version="0.6.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"
config/quit_on_go_back=false

[autoload]

EventBus="*res://autoload/event_bus.gd"
TimeManager="*res://autoload/time_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
GameManager="*res://autoload/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input]

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
environment/ssao/quality.mobile=0
